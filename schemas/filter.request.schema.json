{
  "$defs": {
    "CandidateInput": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CandidateInput",
      "type": "object"
    },
    "DataClassification": {
      "description": "Sensitivity label. Ordered from least to most restricted.",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "DataClassification",
      "type": "integer"
    }
  },
  "$id": "https://github.com/kogunlowo123/runtime-authorization-platform/schemas/filter.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "maxLength": 200,
      "title": "Action",
      "type": "string"
    },
    "candidates": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CandidateInput"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "intent_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Id"
    },
    "resource_type": {
      "maxLength": 200,
      "title": "Resource Type",
      "type": "string"
    },
    "subject_token": {
      "anyOf": [
        {
          "maxLength": 16384,
          "minLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The acting agent's or user's bearer token as presented to the enforcement point. When omitted, the caller is the subject and the request is evaluated as a dry run.",
      "title": "Subject Token"
    }
  },
  "required": [
    "action",
    "resource_type"
  ],
  "title": "FilterRequest",
  "type": "object"
}
