{
  "$defs": {
    "IntentStatus": {
      "enum": [
        "active",
        "consumed",
        "revoked",
        "expired"
      ],
      "title": "IntentStatus",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Action risk tier. Ordered so policies can compare with ``>=``.",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "RiskLevel",
      "type": "integer"
    }
  },
  "$id": "https://github.com/kogunlowo123/runtime-authorization-platform/schemas/intent.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "approved": {
      "title": "Approved",
      "type": "boolean"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approved By"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "justification": {
      "title": "Justification",
      "type": "string"
    },
    "max_uses": {
      "title": "Max Uses",
      "type": "integer"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "resource_type": {
      "title": "Resource Type",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel"
    },
    "status": {
      "$ref": "#/$defs/IntentStatus"
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status Reason"
    },
    "uses": {
      "title": "Uses",
      "type": "integer"
    }
  },
  "required": [
    "intent_id",
    "principal_id",
    "action",
    "resource_type",
    "resource_id",
    "justification",
    "purpose",
    "risk",
    "status",
    "uses",
    "max_uses",
    "created_at",
    "expires_at",
    "approved",
    "approved_by",
    "approved_at",
    "status_reason"
  ],
  "title": "IntentView",
  "type": "object"
}
